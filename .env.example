# Create a form at https://formspree.io and copy only the form ID.
FORMSPREE_FORM_ID=
# Public Cloudflare Turnstile site key. Put its SECRET key in Formspree's CAPTCHA settings.
# Keep CAPTCHA enabled there and choose Cloudflare Turnstile; Formspree verifies the token once.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Set to the public production origin; no trailing slash.
NEXT_PUBLIC_SITE_URL=https://tanvir-portfolio-7mn7.vercel.app
